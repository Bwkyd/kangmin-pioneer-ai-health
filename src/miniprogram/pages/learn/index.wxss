.segment { display: flex; gap: 10rpx; margin: 4rpx 0 22rpx; padding: 7rpx; border: 2rpx solid #dde8e4; border-radius: 20rpx; background: #fff; }
.segment view { flex: 1; padding: 16rpx 7rpx; border-radius: 15rpx; color: #70847d; text-align: center; font-size: 21rpx; font-weight: 700; }
.segment .active { color: #fff; background: #1e5aa3; }
.content-card { display: grid; grid-template-columns: 128rpx minmax(0,1fr); padding: 16rpx; overflow: hidden; border-radius: 22rpx; }
.cover { width: 128rpx; height: 128rpx; border-radius: 18rpx; background: #eaf2fb; }
.content-main { min-width: 0; padding: 2rpx 0 2rpx 18rpx; }
.meta { display: flex; gap: 10rpx; margin-bottom: 9rpx; color: #1e5aa3; font-size: 15rpx; }
.meta text { padding: 5rpx 10rpx; border-radius: 999rpx; background: #eaf2fb; }
.title { margin-bottom: 7rpx; color: #172b45; font-size: 23rpx; font-weight: 700; line-height: 1.45; }
.summary { display: -webkit-box; overflow: hidden; color: #748780; font-size: 18rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.source { margin-top: 9rpx; overflow: hidden; color: #9a7a37; font-size: 14rpx; text-overflow: ellipsis; white-space: nowrap; }
