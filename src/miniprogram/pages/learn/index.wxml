<view class="page learn-page">
  <view class="segment"><view class="{{kind === 'video' ? 'active' : ''}}" data-kind="video" bindtap="switchKind">操作视频</view><view class="{{kind === 'article' ? 'active' : ''}}" data-kind="article" bindtap="switchKind">科普文章</view><view class="{{kind === 'plan' ? 'active' : ''}}" data-kind="plan" bindtap="switchKind">调理方案</view><view class="{{kind === 'qa' ? 'active' : ''}}" data-kind="qa" bindtap="switchKind">知识问答</view></view>

  <view wx:if="{{kind === 'article' || kind === 'video'}}" class="search-box"><input value="{{query}}" placeholder="{{kind === 'video' ? '搜索穴位、手法或症状' : '搜索标题、摘要或分类'}}" bindinput="onSearch" /></view>
  <view wx:if="{{kind === 'video'}}" class="video-catalog">
    <view class="audience-tabs"><view wx:for="{{catalogs}}" wx:key="id" class="audience-tab {{item.id === audience ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseAudience">{{item.label}}</view></view>
    <view class="catalog-note">按已确认的内容目录分类，仅用于查找已发布内容，不代表诊断或证型判断。</view>
    <view class="catalog-body"><view class="catalog-rail"><view wx:for="{{catalog.sections}}" wx:key="id" class="catalog-section {{item.id === activeSectionId ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseSection">{{item.label}}</view></view><view class="catalog-main"><view class="catalog-heading"><text>{{catalog.label}} · {{activeSectionLabel}}</text><text>{{items.length}} 个已发布</text></view><view wx:if="{{activeCategories.length > 1}}" class="catalog-categories"><view wx:for="{{activeCategories}}" wx:key="id" class="catalog-category {{item.id === activeCategoryId ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseCategory">{{item.label}}</view></view></view></view>
  </view>
  <view wx:if="{{loading}}" class="empty-box">正在加载已发布内容…</view>
  <view wx:if="{{error}}" class="error-box">{{error}}</view>

  <view wx:if="{{!loading && !error && (kind === 'article' || kind === 'video') && !items.length}}" class="empty-box">{{kind === 'video' ? (query ? '没有找到匹配的已发布视频' : '该分类暂无已发布视频') : '暂无已发布文章。'}}</view>
  <view wx:if="{{!loading && !error && (kind === 'article' || kind === 'video') && items.length}}" class="content-list"><view wx:for="{{items}}" wx:key="id" class="content-card card" data-id="{{item.id}}" bindtap="openItem"><image wx:if="{{item.coverUrl}}" class="cover" src="{{item.coverUrl}}" mode="aspectFill" /><view wx:else class="cover-placeholder">{{kind === 'video' ? '播' : '知'}}</view><view class="content-main"><view class="meta"><text>{{item.category || '未分类'}}</text><text>{{kind === 'article' ? '文章' : '视频'}}</text></view><view class="title">{{item.title}}</view><view class="summary">{{item.summary || '点击查看内容详情'}}</view><view class="source">来源：{{item.source || '未填写'}}</view></view></view></view>

  <view wx:if="{{!loading && !error && kind === 'plan' && !plans.length}}" class="empty-box">调理方案暂未开放，开放后将在这里展示。</view>
  <view wx:if="{{!loading && !error && kind === 'plan' && plans.length}}" class="plan-list"><view wx:for="{{plans}}" wx:key="id" class="card plan-card" data-id="{{item.id}}" bindtap="openPlan"><view class="meta"><text>调理方案</text></view><view class="title">{{item.name}}</view><view class="summary">点击查看方案步骤与注意事项　›</view></view></view>

  <view wx:if="{{!loading && kind === 'qa'}}" class="qa-card card"><view class="section-title">问鼻健康</view><view class="muted">直接输入你想了解的鼻健康问题。</view><textarea class="qa-input" value="{{qaQuestion}}" maxlength="500" placeholder="例如：换季鼻塞时日常护理要注意什么？" bindinput="onQuestionInput" /><button class="primary-button" loading="{{qaLoading}}" disabled="{{qaLoading}}" bindtap="askKnowledge">提交问题</button><view wx:if="{{qaAnswer}}" class="qa-answer"><view class="answer-text">{{qaAnswer.answer}}</view><view wx:for="{{qaAnswer.sources}}" wx:key="knowledgeId" class="answer-source">来源：{{item.name}}{{item.sourceText}}</view><view class="answer-disclaimer">{{qaAnswer.disclaimer}}</view></view></view>

  <view wx:if="{{detail && detailKind === 'content'}}" class="detail-card card"><view class="detail-back" bindtap="closeDetail">‹ 返回内容中心</view><video wx:if="{{kind === 'video' && mediaUrl}}" class="detail-video" src="{{mediaUrl}}" poster="{{coverUrl}}" controls show-center-play-btn /><image wx:elif="{{coverUrl}}" class="detail-cover" src="{{coverUrl}}" mode="aspectFill" /><view class="category">{{detail.category || '未分类'}} · {{kind === 'video' ? '操作视频' : '科普文章'}}</view><view class="detail-title">{{detail.title}}</view><view class="source">来源：{{detail.source || '未填写'}}</view><view class="summary">{{detail.summary}}</view><rich-text wx:if="{{bodyNodes.length}}" class="body" nodes="{{bodyNodes}}" /><view wx:if="{{kind === 'video' && detail.instructions}}" class="safety-note"><text>操作提示：</text>{{detail.instructions}}</view><view wx:if="{{kind === 'video' && detail.precautions}}" class="safety-note"><text>注意事项：</text>{{detail.precautions}}</view><view class="disclaimer">{{detail.disclaimer}}</view></view>

  <view wx:if="{{detail && detailKind === 'plan'}}" class="detail-card card"><view class="detail-back" bindtap="closeDetail">‹ 返回内容中心</view><view class="category">调理方案</view><view class="detail-title">{{detail.name}}</view><view wx:if="{{detail.summary}}" class="summary">{{detail.summary}}</view><view wx:if="{{detail.steps.length}}" class="steps"><view wx:for="{{detail.steps}}" wx:key="step" class="step"><text class="step-number">{{item.step}}</text><view><text class="step-title">{{item.title}}</text><text wx:if="{{item.description}}">{{item.description}}</text></view></view></view><view wx:if="{{detail.precautions}}" class="safety-note"><text>注意事项：</text>{{detail.precautions}}</view><view wx:if="{{detail.risks}}" class="safety-note"><text>风险提示：</text>{{detail.risks}}</view><view wx:if="{{detail.contraindications}}" class="safety-note"><text>禁忌事项：</text>{{detail.contraindications}}</view><view class="disclaimer">{{detail.disclaimer}}</view></view>

  <view class="learn-footer">内容仅供健康科普与居家管理参考，不能替代门诊诊断。</view>
</view>
