<view class="page">
  <view class="segment">
    <view class="{{kind === 'article' ? 'active' : ''}}" data-kind="article" bindtap="switchKind">科普文章</view>
    <view class="{{kind === 'video' ? 'active' : ''}}" data-kind="video" bindtap="switchKind">操作视频</view>
  </view>
  <view wx:if="{{loading}}" class="empty-box">正在加载已上架内容…</view>
  <view wx:if="{{error}}" class="error-box">{{error}}</view>
  <view wx:if="{{!loading && !error && items.length === 0}}" class="empty-box">后台暂未上架{{kind === 'article' ? '文章' : '视频'}}。</view>
  <view wx:for="{{items}}" wx:key="id" class="content-card card" data-id="{{item.id}}" bindtap="openItem">
    <image wx:if="{{item.coverUrl}}" class="cover" src="{{item.coverUrl}}" mode="aspectFill" />
    <view class="content-main">
      <view class="meta"><text>{{item.category}}</text><text>{{kind === 'article' ? '文章' : '视频'}}</text></view>
      <view class="title">{{item.title}}</view>
      <view class="summary">{{item.summary}}</view>
      <view class="source">来源：{{item.source}}</view>
    </view>
  </view>
</view>
