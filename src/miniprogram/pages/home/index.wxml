<view class="page home-view">
  <view class="home-identity">
    <view class="identity-main">
      <view class="identity-mark">抗</view>
      <view class="identity-copy">
        <text class="brand-name">抗敏先锋</text>
        <text class="brand-subtitle">鼻健康管理</text>
      </view>
    </view>
    <text class="identity-badge">今日健康</text>
  </view>

  <view class="home-intro">
    <text class="intro-eyebrow">鼻健康 · 记录与陪伴</text>
    <text class="intro-title">今天，也照顾好自己</text>
    <text class="intro-copy">从一次记录开始，慢慢了解身体的变化。</text>
  </view>

  <view class="primary-entry" bindtap="openAssistant">
    <view class="entry-head">
      <view class="entry-icon">问</view>
      <text class="entry-label">固定规则优先 · 安全评估</text>
    </view>
    <text class="entry-title">问助手</text>
    <text class="entry-copy">逐步回答几个问题，获得清晰的情况说明与下一步建议。</text>
    <view class="entry-foot"><text>开始评估</text><text class="entry-arrow">→</text></view>
    <text class="entry-watermark">问</text>
  </view>

  <view class="quick-heading">今天要做什么</view>
  <view class="quick-grid">
    <view class="quick-card" bindtap="openAssessment">
      <view class="quick-icon blue-icon">记</view>
      <text class="quick-label">每日记录</text>
      <text class="quick-title">记录症状</text>
      <text class="quick-link">填写量表　→</text>
    </view>
    <view class="quick-card" bindtap="openCalendar">
      <view class="quick-icon gold-icon">日</view>
      <text class="quick-label">变化可追踪</text>
      <text class="quick-title">健康日历</text>
      <text class="quick-link">查看趋势　→</text>
    </view>
    <view class="quick-card" bindtap="openLearn">
      <view class="quick-icon teal-icon">知</view>
      <text class="quick-label">已审核内容</text>
      <text class="quick-title">科普内容</text>
      <text class="quick-link">文章与视频　→</text>
    </view>
    <view class="quick-card" bindtap="openMessages">
      <view class="quick-icon ink-icon">信</view>
      <text class="quick-label">服务提醒</text>
      <text class="quick-title">消息中心</text>
      <text class="quick-link">查看消息　→</text>
    </view>
  </view>

  <view class="health-card" bindtap="openCalendar">
    <view class="health-head">
      <view><text class="health-eyebrow">我的健康记录</text><text class="health-title">{{overview ? '记录已同步' : '从今天开始记录'}}</text></view>
      <text class="health-action">{{overview ? '查看日历　›' : '去记录　›'}}</text>
    </view>
    <view wx:if="{{overview}}" class="health-stats">
      <view><text class="health-number">{{overview.consecutiveDays}}</text><text>连续记录 / 天</text></view>
      <view><text class="health-number">{{overview.monthRecordCount}}</text><text>本月记录 / 次</text></view>
      <view><text class="health-number">{{overview.lastTnss === null ? '--' : overview.lastTnss}}</text><text>最近症状评分</text></view>
    </view>
    <view wx:else class="health-empty"><text>完成首次症状记录后，这里会显示连续天数和月度变化。</text></view>
  </view>
  <view wx:if="{{overviewError}}" class="inline-notice">{{overviewError}}</view>

  <view class="section-heading"><view><text class="section-eyebrow">精选内容</text><text class="heading-title">今天读点什么</text></view><text class="heading-link" bindtap="openLearn">全部　›</text></view>
  <view wx:if="{{featured}}" class="featured-card" bindtap="openFeatured">
    <image wx:if="{{featured.coverUrl}}" class="featured-cover" src="{{featured.coverUrl}}" mode="aspectFill" />
    <view wx:else class="featured-art"><text>{{featured.kind === 'video' ? '播' : '知'}}</text></view>
    <view class="featured-copy"><text class="featured-type">{{featured.kind === 'video' ? '操作视频' : '科普文章'}}</text><text class="featured-title">{{featured.title}}</text><text class="featured-summary">{{featured.summary || '打开查看已发布的鼻健康内容'}}</text></view>
  </view>
  <view wx:else class="featured-empty" bindtap="openLearn"><text class="featured-empty-title">科普内容正在准备中</text><text>进入内容中心查看已发布文章和视频　›</text></view>
  <view wx:if="{{contentError}}" class="inline-notice">{{contentError}}</view>
</view>
