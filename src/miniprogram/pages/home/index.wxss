.home-view { padding-top: 28rpx; }
.home-identity { display: flex; align-items: center; justify-content: space-between; margin-bottom: 34rpx; }
.identity-main { display: flex; align-items: center; gap: 16rpx; }
.identity-mark { display: flex; width: 68rpx; height: 68rpx; align-items: center; justify-content: center; border-radius: 22rpx; color: #fff; background: linear-gradient(145deg,#2d76bc,#123c70); box-shadow: 0 10rpx 24rpx rgba(18,60,112,.2); font-family: STKaiti, KaiTi, serif; font-size: 34rpx; font-weight: 700; }
.identity-copy { display: flex; flex-direction: column; }
.brand-name { color: #163c68; font-family: STSong, "Songti SC", serif; font-size: 29rpx; font-weight: 700; letter-spacing: 2rpx; }
.brand-subtitle { margin-top: 3rpx; color: #8a9aab; font-size: 17rpx; letter-spacing: 2rpx; }
.identity-badge { padding: 10rpx 16rpx; border: 1rpx solid #d9e7f2; border-radius: 99rpx; color: #4f7598; background: #f8fbfe; font-size: 17rpx; }
.home-intro { display: flex; flex-direction: column; margin-bottom: 24rpx; }
.intro-eyebrow { color: #b18428; font-size: 18rpx; font-weight: 700; letter-spacing: 1rpx; }
.intro-title { margin-top: 8rpx; color: #152f50; font-family: STSong, "Songti SC", serif; font-size: 43rpx; font-weight: 700; letter-spacing: 1rpx; }
.intro-copy { margin-top: 9rpx; color: #7c8da1; font-size: 20rpx; line-height: 1.6; }
.primary-entry { position: relative; display: flex; min-height: 294rpx; box-sizing: border-box; flex-direction: column; overflow: hidden; padding: 30rpx; border-radius: 30rpx; color: #fff; background: linear-gradient(140deg,#2a73b8 0%,#164b83 62%,#10365f 100%); box-shadow: 0 22rpx 44rpx rgba(18,59,115,.2); }
.entry-head { display: flex; align-items: center; gap: 12rpx; }
.entry-icon { display: flex; width: 56rpx; height: 56rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(255,255,255,.24); border-radius: 18rpx; color: #fff; background: rgba(255,255,255,.15); font-family: STKaiti, KaiTi, serif; font-size: 29rpx; font-weight: 700; }
.entry-label { color: #cfe3f7; font-size: 17rpx; }
.entry-title { position: relative; z-index: 1; margin-top: 28rpx; font-family: STSong, "Songti SC", serif; font-size: 43rpx; font-weight: 700; }
.entry-copy { position: relative; z-index: 1; max-width: 490rpx; margin-top: 12rpx; color: #dbeafb; font-size: 20rpx; line-height: 1.65; }
.entry-foot { position: relative; z-index: 1; display: flex; margin-top: auto; align-items: center; justify-content: space-between; color: #fff; font-size: 20rpx; font-weight: 700; }
.entry-arrow { font-size: 33rpx; font-weight: 400; }
.entry-watermark { position: absolute; right: -18rpx; bottom: -54rpx; color: rgba(255,255,255,.08); font-family: STKaiti, KaiTi, serif; font-size: 190rpx; font-weight: 700; }
.quick-heading { margin: 34rpx 2rpx 16rpx; color: #223e60; font-size: 25rpx; font-weight: 700; }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.quick-card { display: flex; min-height: 208rpx; box-sizing: border-box; flex-direction: column; align-items: flex-start; padding: 22rpx; border: 1rpx solid #e0e9f2; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(27,64,101,.05); }
.quick-icon { display: flex; width: 52rpx; height: 52rpx; align-items: center; justify-content: center; margin-bottom: 18rpx; border-radius: 17rpx; font-size: 25rpx; font-weight: 700; }
.blue-icon { color: #1e5e9e; background: #e7f1fb; }
.gold-icon { color: #9a6d13; background: #fff3d6; }
.teal-icon { color: #187e72; background: #e2f5f0; }
.ink-icon { color: #566785; background: #edf0f7; }
.quick-label { color: #93a0ad; font-size: 17rpx; }
.quick-title { margin-top: 6rpx; color: #1b385b; font-size: 24rpx; font-weight: 700; }
.quick-link { margin-top: auto; color: #3977aa; font-size: 18rpx; }
.health-card { margin-top: 22rpx; padding: 24rpx; border: 1rpx solid #dbe7f1; border-radius: 26rpx; background: linear-gradient(145deg,#fafdff,#f0f6fb); }
.health-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14rpx; }
.health-head > view { display: flex; flex-direction: column; }
.health-eyebrow { color: #68809a; font-size: 17rpx; }
.health-title { margin-top: 7rpx; color: #183a60; font-size: 26rpx; font-weight: 700; }
.health-action { color: #3170a6; font-size: 18rpx; }
.health-stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 10rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #dce8f1; }
.health-stats view { display: flex; flex-direction: column; color: #8091a2; font-size: 16rpx; line-height: 1.5; }
.health-number { color: #1d4e7c; font-size: 30rpx; font-weight: 700; }
.health-empty { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #dce8f1; color: #7890a4; font-size: 18rpx; line-height: 1.6; }
.inline-notice { margin-top: 10rpx; color: #9a6459; font-size: 17rpx; line-height: 1.5; }
.section-heading { display: flex; margin: 36rpx 2rpx 16rpx; align-items: flex-end; justify-content: space-between; }
.section-heading > view { display: flex; flex-direction: column; }
.section-eyebrow { color: #b18428; font-size: 17rpx; font-weight: 700; }
.heading-title { margin-top: 6rpx; color: #1b385b; font-size: 28rpx; font-weight: 700; }
.heading-link { color: #3170a6; font-size: 18rpx; }
.featured-card { display: flex; min-height: 168rpx; overflow: hidden; border: 1rpx solid #e0e9f2; border-radius: 25rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(27,64,101,.05); }
.featured-cover,.featured-art { flex: 0 0 36%; width: 36%; min-height: 168rpx; }
.featured-cover { display: block; }
.featured-art { display: flex; align-items: flex-end; justify-content: flex-start; padding: 20rpx; box-sizing: border-box; background: linear-gradient(145deg,#d9e9f7,#f8ecd3); }
.featured-art text { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border-radius: 50%; color: #205b95; background: rgba(255,255,255,.9); font-family: STKaiti, KaiTi, serif; font-size: 29rpx; font-weight: 700; }
.featured-copy { display: flex; min-width: 0; padding: 22rpx; flex-direction: column; justify-content: center; }
.featured-type { color: #b18428; font-size: 17rpx; font-weight: 700; }
.featured-title { margin-top: 8rpx; overflow: hidden; color: #1b385b; font-size: 23rpx; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
.featured-summary { display: -webkit-box; margin-top: 8rpx; overflow: hidden; color: #8191a0; font-size: 17rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.featured-empty { display: flex; min-height: 130rpx; box-sizing: border-box; flex-direction: column; justify-content: center; padding: 24rpx; border: 1rpx dashed #cbdbe9; border-radius: 25rpx; color: #7d90a2; background: #fbfdff; font-size: 18rpx; line-height: 1.6; }
.featured-empty-title { margin-bottom: 5rpx; color: #315c82; font-size: 22rpx; font-weight: 700; }
