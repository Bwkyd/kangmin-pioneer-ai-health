<view class="page assistant-page">
  <view class="safety-banner">
    <view class="safety-icon">库</view>
    <view class="safety-copy"><text>安全评估与方案建议</text><text>服务端固定规则优先 · 结果经过安全校验后展示</text></view>
  </view>

  <view class="chat-toolbar">
    <button class="toolbar-button" bindtap="toggleHistory">☰ 历史对话</button>
    <button class="toolbar-button" bindtap="startNewConversation">＋ 新建聊天</button>
  </view>

  <view wx:if="{{historyOpen}}" class="history-panel">
    <view class="history-heading"><text>历史对话</text><text>仅显示当前患者的已保存会话</text></view>
    <view wx:if="{{historyLoading}}" class="empty-state">正在读取历史对话…</view>
    <view wx:elif="{{historyError}}" class="error-box"><text>{{historyError}}</text><button class="secondary-button compact-button" bindtap="loadHistory">重试</button></view>
    <view wx:elif="{{history.length === 0}}" class="empty-state">暂无已保存的对话。</view>
    <button wx:for="{{history}}" wx:key="id" class="history-item" data-id="{{item.id}}" bindtap="selectConversation">
      <view><text class="history-state">{{item.stateLabel}}</text><text class="history-date">{{item.displayDate}}</text></view>
      <text class="history-id">继续这段对话</text>
      <text class="history-arrow">›</text>
    </button>
  </view>

  <view wx:if="{{loading}}" class="empty-state">正在恢复上次对话…</view>
  <view wx:if="{{error}}" class="error-box" role="alert"><text>{{error}}</text><button wx:if="{{retryMessage}}" class="secondary-button compact-button" bindtap="retry">重试</button></view>

  <view class="chat-list">
    <view wx:for="{{messages}}" wx:key="id" class="message-row {{item.role}} {{item.kind}}">
      <view class="message-bubble">
        <text wx:if="{{item.kind === 'thinking'}}" class="thinking-text">{{item.text}}</text>
        <text wx:else selectable="true">{{item.text}}</text>
        <text wx:if="{{item.displayDate && item.kind !== 'thinking'}}" class="message-time">{{item.displayDate}}</text>
        <view wx:if="{{item.kind === 'result'}}" class="result-disclaimer">结果仅供参考，最终方案请以门诊诊断为准。</view>
      </view>
    </view>
  </view>

  <view wx:if="{{startAvailable && hydrated}}" class="start-card">
    <image src="/assets/assistant-mascot-static.png" mode="widthFix" />
    <view class="start-copy"><text class="start-title">开始了解我的情况</text><text>通过对话采集症状，服务端按固定规则逐步评估；不会由小程序自行判断证型。</text></view>
    <button class="primary-button start-button" bindtap="beginConsultation">开始评估</button>
  </view>

  <view wx:if="{{pendingQuestions.length}}" class="pending-card">
    <view class="pending-title"><text>下一步请回答</text><text>不清楚也可以直接说明</text></view>
    <view wx:for="{{pendingQuestions}}" wx:key="fieldCode" class="pending-question"><text>{{item.prompt}}</text></view>
    <text class="pending-hint">请在下方输入自然语言回答，服务端会继续核对，不会把不确定当成“没有”。</text>
  </view>

  <view wx:if="{{endReason}}" class="end-card"><text>{{endReason}}</text><button class="secondary-button" bindtap="startNewConversation">新建聊天</button><button class="secondary-button" bindtap="startReassessment">重新评估</button></view>

  <view class="composer">
    <image class="composer-mascot" src="/assets/assistant-mascot-static.png" mode="widthFix" />
    <input class="composer-input" value="{{input}}" maxlength="4096" confirm-type="send" placeholder="{{!hydrated ? '正在恢复对话…' : !canSend ? '该对话已结束' : sending ? '正在发送…' : followUpEnabled ? '继续追问当前方案…' : '输入症状或问题…'}}" disabled="{{!hydrated || sending || !canSend}}" bindinput="onInput" bindconfirm="sendFromInput" />
    <button class="send-button" disabled="{{!hydrated || sending || !canSend || !input}}" loading="{{sending}}" bindtap="sendCurrent">↑</button>
  </view>

  <view class="assistant-footer">内容仅供健康科普与居家管理参考，不能替代门诊诊断。</view>
</view>
