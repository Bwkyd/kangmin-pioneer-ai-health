<view class="assistant-page">
  <view class="custom-navigation" style="padding-top: {{statusBarHeight}}px; height: {{navigationBarHeight}}px;">
    <view class="menu-hitarea" role="button" aria-label="打开聊天记录" bindtap="toggleHistory">
      <view class="menu-icon"><view></view><view></view><view></view></view>
    </view>
    <view class="navigation-copy">
      <text class="navigation-title">抗敏先锋</text>
      <text class="navigation-subtitle">鼻健康智能助手</text>
    </view>
  </view>

  <view wx:if="{{historyOpen}}" class="history-overlay">
    <view class="history-mask" bindtap="closeHistory"></view>
    <view class="history-drawer" style="padding-top: {{statusBarHeight}}px;">
      <view class="history-drawer-head" style="height: {{navigationBarHeight}}px;">
        <view>
          <text class="history-title">聊天记录</text>
          <text class="history-subtitle">选择对话继续了解</text>
        </view>
        <button class="new-chat-button" aria-label="新建聊天" bindtap="startNewConversation">
          <view class="new-chat-icon"></view>
        </button>
      </view>
      <view class="history-list">
        <view wx:if="{{historyLoading}}" class="drawer-state">正在读取…</view>
        <view wx:elif="{{historyUnavailable}}" class="drawer-state">暂无聊天记录</view>
        <view wx:elif="{{historyError}}" class="drawer-error"><text>{{historyError}}</text><button class="compact-button" bindtap="loadHistory">重试</button></view>
        <view wx:elif="{{history.length === 0}}" class="drawer-state">暂无已保存的对话</view>
        <button wx:for="{{history}}" wx:key="id" class="history-item {{item.id === conversationId ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectConversation">
          <text class="history-item-title">{{item.displayDate}}</text>
          <text class="history-item-meta">{{item.stateLabel}}</text>
        </button>
      </view>
    </view>
  </view>

  <view class="chat-list">
    <view class="time-label">{{timeLabel}}</view>
    <view wx:if="{{loading}}" class="empty-state">正在恢复上次对话…</view>
    <view wx:if="{{error}}" class="error-box" role="alert"><text>{{error}}</text><button wx:if="{{retryMessage}}" class="secondary-button compact-button" bindtap="retry">重试</button></view>

    <view wx:for="{{messages}}" wx:key="id">
      <view wx:if="{{item.kind === 'result'}}" class="result-card" aria-label="评估结果">
        <view class="result-head"><view><text>评估已完成</text><text>{{item.resultPhase}}</text></view><text>评估结果</text></view>
        <view class="result-body">
          <view wx:for="{{item.resultBlocks}}" wx:for-item="block" wx:key="index" class="result-block {{block.type}}">
            <text wx:if="{{block.type === 'text'}}" user-select="true">{{block.text}}</text>
            <view wx:elif="{{block.type === 'video'}}" class="plan-video-button" role="button" aria-label="观看{{block.method}}操作视频" hover-class="plan-video-button-pressed" data-id="{{block.id}}" bindtap="openPlanVideo"><text>▶</text><text>观看操作视频</text></view>
          </view>
        </view>
        <view class="result-foot"><text>方案来源</text><text>已审核的体质调理方案</text></view>
        <view class="result-disclaimer">结果仅供参考，最终方案请以门诊诊断为准。</view>
      </view>
      <view wx:else class="message-row {{item.role}} {{item.kind}}">
        <image wx:if="{{item.role === 'assistant'}}" class="mini-avatar" src="/assets/assistant-avatar.png" mode="aspectFill" />
        <view class="message-bubble">
          <view wx:if="{{item.kind === 'thinking'}}" class="typing"><text></text><text></text><text></text></view>
          <text wx:else user-select="true">{{item.text}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{capabilityUnavailable && hydrated}}" class="unavailable-card" role="status">
      <text>问助手暂未开放</text>
      <text>完成正式微信联调后即可使用。</text>
    </view>

    <view wx:if="{{startAvailable && hydrated}}" class="start-card {{sending ? 'disabled' : ''}}" role="button" aria-label="{{nextStartMode === 'reassess' ? '重新测评鼻敏感情况' : '开始鼻敏感测评'}}" hover-class="start-card-pressed" bindtap="beginConsultation">
      <text class="start-icon">鼻</text>
      <view class="start-copy">
        <text>{{nextStartMode === 'reassess' ? '重新测一测鼻敏感情况' : '测一测我的鼻敏感情况'}}</text>
        <text>{{nextStartMode === 'reassess' ? '新测评完成后才会替代原结果' : '约 2 分钟，回答几个简单问题'}}</text>
      </view>
      <view class="start-action"><text>{{nextStartMode === 'reassess' ? '重新测评' : '开始测评'}}</text><text>›</text></view>
    </view>

    <view wx:if="{{pendingQuestions.length}}" class="pending-card">
      <view wx:for="{{pendingQuestions}}" wx:key="fieldCode" class="pending-question">
        <view class="pending-title"><text>问</text><text>{{item.title}}</text></view>
        <view wx:for="{{item.options}}" wx:for-item="option" wx:key="value" class="pending-option {{sending ? 'disabled' : ''}}" role="button" aria-label="{{option.text}}" data-value="{{option.value}}" hover-class="pending-option-pressed" bindtap="answerPending"><text>{{option.code}}</text><text>{{option.text}}</text></view>
      </view>
    </view>

    <view wx:if="{{followUpEnabled}}" class="end-card"><text>评估已完成，你可以继续追问当前方案。</text><button bindtap="startNewConversation">新建聊天</button><button bindtap="startReassessment">重新评估</button></view>
    <view wx:elif="{{endReason}}" class="end-card"><text>{{endReason}}</text><button bindtap="startNewConversation">新建聊天</button><button bindtap="startReassessment">重新评估</button></view>
  </view>

  <view class="composer">
    <image class="composer-mascot" src="/assets/assistant-mascot-loop-v3.gif" mode="aspectFit" />
    <input class="composer-input" placeholder-class="composer-placeholder" value="{{input}}" maxlength="4096" confirm-type="send" placeholder="{{!hydrated ? '正在恢复对话…' : capabilityUnavailable ? '问助手将在正式微信联调后开放' : !canSend ? '该对话已结束' : sending ? '正在发送…' : followUpEnabled ? '继续追问当前方案…' : '问问题或描述症状…'}}" disabled="{{!hydrated || sending || !canSend || capabilityUnavailable}}" bindinput="onInput" bindconfirm="sendFromInput" />
    <view class="send-button {{(!hydrated || sending || !canSend || capabilityUnavailable) ? 'disabled' : ''}}" role="button" aria-label="发送" hover-class="send-button-pressed" bindtap="sendCurrent"><text>{{sending ? '…' : '↑'}}</text></view>
  </view>
</view>
