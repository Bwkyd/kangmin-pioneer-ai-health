.detail-page { padding-right: 24rpx; padding-left: 24rpx; }
.video,.cover { width: 100%; height: 360rpx; border-radius: 24rpx; background: #102438; }
.article { margin-top: 18rpx; }
.category { color: #1e5aa3; font-size: 17rpx; }
.title { margin: 16rpx 0 10rpx; color: #172b45; font-family: STSong, "Songti SC", serif; font-size: 34rpx; font-weight: 700; line-height: 1.4; }
.source { color: #8a9a93; font-size: 17rpx; }
.summary { margin: 22rpx 0; padding: 18rpx; border-left: 5rpx solid #7fa7d3; border-radius: 0 14rpx 14rpx 0; color: #49647c; background: #eef5fd; font-size: 21rpx; line-height: 1.7; }
.body { color: #41564e; font-size: 22rpx; line-height: 1.8; white-space: pre-wrap; }
.disclaimer { margin-top: 26rpx; padding-top: 18rpx; border-top: 2rpx solid #e5edf5; color: #9aa7a2; font-size: 17rpx; line-height: 1.65; }
