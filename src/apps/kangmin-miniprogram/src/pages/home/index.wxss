.home-view { padding: 28rpx 28rpx 170rpx; background: #f4f7fb; }
.brand-banner { position: relative; height: calc((100vw - 56rpx) / 3); margin-bottom: 20rpx; overflow: hidden; border-radius: 32rpx; background: #1d4f91; box-shadow: 0 20rpx 48rpx rgba(18,59,115,.20); }
.brand-banner::after { position: absolute; inset: 0; border: 2rpx solid rgba(255,255,255,.2); border-radius: inherit; content: ""; pointer-events: none; }
.brand-banner image { position: absolute; top: 50%; left: -4%; width: 112.2%; height: auto; transform: translateY(-50%); }
.home-modules { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.service-module { position: relative; display: flex; min-height: 380rpx; flex-direction: column; align-items: flex-start; box-sizing: border-box; overflow: hidden; padding: 34rpx; border-radius: 40rpx; box-shadow: 0 28rpx 56rpx rgba(18,59,115,.13); }
.diagnose-module { color: #fff; background: linear-gradient(145deg,#2868b3,#123b73); }
.learn-module { border: 2rpx solid #d8e5f4; color: #173d70; background: linear-gradient(145deg,#f7fbff,#e7f0fb); }
.module-icon { display: flex; width: 74rpx; height: 74rpx; margin-bottom: 34rpx; align-items: center; justify-content: center; border-radius: 24rpx; font-family: STKaiti, KaiTi, serif; font-size: 36rpx; font-weight: 700; }
.diagnose-module .module-icon { background: rgba(255,255,255,.18); }
.learn-module .module-icon { color: #1e5aa3; background: #fff; box-shadow: 0 8rpx 24rpx rgba(30,90,163,.10); }
.module-kicker { position: relative; z-index: 1; font-size: 18rpx; }
.diagnose-module .module-kicker { color: #c9def6; }
.learn-module .module-kicker { color: #6f87a4; }
.module-title { position: relative; z-index: 1; margin-top: 6rpx; font-family: STSong, "Songti SC", serif; font-size: 42rpx; font-weight: 700; }
.module-copy { position: relative; z-index: 1; min-height: 88rpx; margin: 16rpx 0 26rpx; font-size: 20rpx; line-height: 1.6; }
.diagnose-module .module-copy { color: #d8e6f6; }
.learn-module .module-copy { color: #617895; }
.module-link { position: relative; z-index: 1; margin-top: auto; font-size: 20rpx; font-weight: 700; }
.module-link > text { margin-left: 10rpx; font-size: 28rpx; }
.module-watermark { position: absolute; right: -24rpx; bottom: -54rpx; font-family: STKaiti, KaiTi, serif; font-size: 176rpx; opacity: .08; }
.basis-card { display: flex; gap: 20rpx; margin-top: 20rpx; padding: 24rpx 26rpx; border: 2rpx solid #d6e3f2; border-radius: 30rpx; background: linear-gradient(135deg,#f8fbff,#edf4fc); box-shadow: 0 14rpx 36rpx rgba(18,59,115,.05); }
.basis-icon { display: flex; flex: 0 0 56rpx; width: 56rpx; height: 56rpx; align-items: center; justify-content: center; border-radius: 18rpx; color: #fff; background: #1e5aa3; font-family: STKaiti, KaiTi, serif; font-size: 30rpx; font-weight: 700; }
.basis-copy { display: flex; min-width: 0; flex-direction: column; color: #5f7390; font-size: 18rpx; line-height: 1.55; }
.basis-title { margin-bottom: 6rpx; color: #173d70; font-size: 22rpx; font-weight: 700; line-height: 1.5; }
.basis-note { margin-top: 8rpx; color: #8a6a32; font-size: 16rpx; line-height: 1.5; }
.today-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-top: 24rpx; }
.today-card { display: flex; min-height: 252rpx; box-sizing: border-box; flex-direction: column; align-items: flex-start; padding: 26rpx; border: 2rpx solid #dce6f2; border-radius: 32rpx; background: #fff; box-shadow: 0 14rpx 40rpx rgba(18,59,115,.055); }
.feature-icon { display: flex; width: 62rpx; height: 62rpx; margin-bottom: 24rpx; align-items: center; justify-content: center; border-radius: 20rpx; color: #1e5aa3; background: #eaf2fb; font-weight: 700; }
.book-icon { color: #9a6d12; background: #fff4d8; }
.today-kicker { color: #8c9a95; font-size: 20rpx; }
.today-title { margin: 6rpx 0; font-size: 26rpx; font-weight: 700; }
.today-link { color: #1e5aa3; font-size: 20rpx; }
.mini-trend { display: grid; grid-template-columns: 1fr 220rpx; align-items: center; margin-top: 20rpx; padding: 28rpx; border: 2rpx solid #dce6f2; border-radius: 32rpx; background: #fff; box-shadow: 0 14rpx 40rpx rgba(18,59,115,.055); }
.trend-copy { display: flex; min-width: 0; flex-direction: column; color: #91a099; font-size: 20rpx; }
.trend-title { margin-top: 8rpx; color: #172b45; font-size: 28rpx; font-weight: 700; }
.trend-link { margin-top: 16rpx; color: #1e5aa3; font-size: 20rpx; }
.sparkline { display: flex; height: 96rpx; align-items: flex-end; justify-content: space-around; gap: 10rpx; }
.sparkline view { flex: 1; max-width: 20rpx; border-radius: 12rpx 12rpx 4rpx 4rpx; background: #b8d6c9; }
.sparkline .active { background: #d2a43a; }
.section-heading { display: flex; margin: 36rpx 2rpx 20rpx; align-items: flex-end; justify-content: space-between; }
.section-heading > view { display: flex; flex-direction: column; color: #d2a43a; font-size: 20rpx; font-weight: 700; }
.heading-title { margin-top: 6rpx; color: #172b45; font-size: 32rpx; }
.heading-link { color: #1e5aa3; font-size: 22rpx; }
.article-feature { display: grid; grid-template-columns: 38% 62%; overflow: hidden; border: 2rpx solid #dce6f2; border-radius: 32rpx; background: #fff; }
.article-art { position: relative; min-height: 210rpx; overflow: hidden; background: linear-gradient(145deg,#daeadd,#f5e8d7); }
.art-circle { position: absolute; left: -40rpx; bottom: -44rpx; width: 160rpx; height: 160rpx; border-radius: 50%; background: #8eb8a4; }
.art-leaf { position: absolute; right: 32rpx; bottom: -30rpx; width: 110rpx; height: 180rpx; border-radius: 55% 10% 50% 10%; background: #3d7c65; opacity: .8; transform: rotate(25deg); }
.article-art text { position: absolute; left: 40rpx; top: 32rpx; display: flex; width: 68rpx; height: 68rpx; align-items: center; justify-content: center; border-radius: 50%; color: #1e5aa3; background: rgba(255,255,255,.9); font-family: STSong, serif; font-size: 36rpx; font-weight: 700; }
.article-copy { display: flex; padding: 26rpx; flex-direction: column; justify-content: center; color: #d2a43a; font-size: 20rpx; }
.article-title { margin: 10rpx 0; color: #172b45; font-size: 26rpx; font-weight: 700; line-height: 1.5; }
.article-meta { color: #8b9994; font-size: 20rpx; }
