.profile-page { background: linear-gradient(180deg,#edf4fc 0,#f3f6fb 430rpx); }
.intro-card { display: flex; margin-bottom: 18rpx; padding: 25rpx; flex-direction: column; border-radius: 28rpx; color: #fff; background: linear-gradient(135deg,#245fa7,#123b73); box-shadow: 0 18rpx 38rpx rgba(18,59,115,.16); }
.intro-label { color: #d1e3f5; font-size: 17rpx; }.intro-title { margin-top: 7rpx; font-family: STSong,serif; font-size: 35rpx; font-weight: 700; }.intro-copy { margin-top: 12rpx; color: #d6e7f7; font-size: 18rpx; line-height: 1.65; }
.field-label { margin: 17rpx 0 8rpx; color: #5e718a; font-size: 18rpx; font-weight: 700; }.field-input,.field-picker,.field-textarea { box-sizing: border-box; width: 100%; min-height: 76rpx; padding: 18rpx; border: 2rpx solid #dce6f2; border-radius: 17rpx; color: #243d5a; background: #fbfdff; font-size: 21rpx; }.field-picker { color: #315f8d; }.field-textarea { min-height: 150rpx; line-height: 1.6; }
.card > .primary-button { margin-top: 22rpx; }.factor-group { margin-top: 20rpx; }.factor-title { color: #315574; font-size: 19rpx; font-weight: 700; }.factor-list { display: flex; margin-top: 8rpx; flex-wrap: wrap; gap: 10rpx; }.factor-chip { padding: 11rpx 14rpx; border: 2rpx solid #dce6f2; border-radius: 99rpx; color: #62778d; background: #fff; font-size: 17rpx; }.factor-chip.selected { border-color: #1e5aa3; color: #fff; background: #1e5aa3; }
.form-actions { display: flex; margin-top: 20rpx; justify-content: flex-end; gap: 12rpx; }.form-actions button { margin: 0; padding: 8rpx 16rpx; font-size: 18rpx; line-height: 1.6; }.record-empty { margin-top: 18rpx; color: #8a98a9; font-size: 18rpx; }.record-row { display: flex; margin-top: 14rpx; padding-top: 14rpx; align-items: center; gap: 12rpx; border-top: 2rpx solid #edf1f6; }.record-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; color: #718096; font-size: 17rpx; line-height: 1.55; }.record-title { color: #315574; font-size: 19rpx; font-weight: 700; }.row-actions { display: flex; flex: 0 0 auto; gap: 6rpx; }.row-actions button { margin: 0; padding: 6rpx 10rpx; border: 1rpx solid #c6d9eb; border-radius: 14rpx; color: #1e5aa3; background: #fff; font-size: 16rpx; line-height: 1.5; }.row-actions button:last-child { color: #a34f45; border-color: #e3c2bd; }.inline-fields { display: flex; gap: 10rpx; }.inline-fields .field-input:first-child { flex: 1; }.inline-fields .field-input:last-child { flex: 1; }.check-line,.consent-row { display: flex; margin-top: 13rpx; align-items: center; gap: 10rpx; color: #61748a; font-size: 18rpx; }.checkbox { display: flex; width: 34rpx; height: 34rpx; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx solid #9bb2ca; border-radius: 8rpx; color: #fff; background: #fff; }.checkbox.checked { border-color: #1e5aa3; background: #1e5aa3; }.consent-card { margin-top: 20rpx; }.profile-disclaimer { padding: 6rpx 22rpx 0; color: #8492a6; text-align: center; font-size: 16rpx; line-height: 1.65; }
