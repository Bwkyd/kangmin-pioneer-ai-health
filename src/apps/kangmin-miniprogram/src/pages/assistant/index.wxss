.assistant-page { display: flex; height: calc(100vh - 108rpx - env(safe-area-inset-bottom)); min-height: 0; flex-direction: column; overflow: hidden; background: #f5f7fb; }
.custom-navigation { position: relative; display: flex; flex: 0 0 auto; box-sizing: content-box; align-items: center; border-bottom: 2rpx solid rgba(255,255,255,.12); color: #fff; background: #1e5d9f; }
.navigation-copy { position: absolute; left: 50%; display: flex; flex-direction: column; align-items: center; transform: translateX(-50%); white-space: nowrap; }
.navigation-title { font-size: 24rpx; font-weight: 700; line-height: 1.15; }
.navigation-subtitle { margin-top: 4rpx; color: rgba(255,255,255,.76); font-size: 16rpx; line-height: 1.15; }
.menu-hitarea { position: absolute; z-index: 2; bottom: 0; left: 40rpx; display: flex; width: 72rpx; height: 64rpx; box-sizing: border-box; align-items: center; justify-content: center; border-radius: 18rpx; }
.menu-icon { display: flex; width: 34rpx; flex-direction: column; gap: 7rpx; }
.menu-icon > view { width: 34rpx; height: 4rpx; flex: 0 0 auto; border-radius: 4rpx; background: #fff; }
.new-chat-button::after, .history-item::after, .end-card button::after { border: 0; }
.history-overlay { position: fixed; z-index: 2000; inset: 0; }
.history-mask { position: absolute; inset: 0; background: rgba(14,30,45,.38); }
.history-drawer { position: absolute; top: 0; bottom: 0; left: 0; display: flex; width: 76%; box-sizing: border-box; flex-direction: column; background: #f8fafc; box-shadow: 16rpx 0 46rpx rgba(11,39,75,.18); }
.history-drawer-head { display: flex; box-sizing: border-box; padding: 0 30rpx 0 34rpx; flex: 0 0 auto; align-items: center; justify-content: space-between; border-bottom: 2rpx solid #dfe7ef; }
.history-drawer-head > view:first-child { display: flex; flex-direction: column; }
.history-title { color: #173d70; font-size: 30rpx; font-weight: 700; }
.history-subtitle { margin-top: 4rpx; color: #7b8c9c; font-size: 20rpx; }
.new-chat-button { display: flex; width: 72rpx; height: 72rpx; margin: 0; padding: 0; align-items: center; justify-content: center; border: 0; border-radius: 20rpx; background: transparent; }
.new-chat-icon { position: relative; width: 34rpx; height: 34rpx; box-sizing: border-box; border: 4rpx solid #1e5aa3; border-radius: 7rpx; }
.new-chat-icon::before { content: ""; position: absolute; right: -5rpx; top: -5rpx; width: 24rpx; height: 7rpx; border: 3rpx solid #f8fafc; border-radius: 5rpx; background: #1e5aa3; transform: rotate(-45deg); }
.history-list { min-height: 0; flex: 1; box-sizing: border-box; padding: 20rpx 32rpx 40rpx; overflow-y: auto; }
.history-item { display: flex; width: 100%; box-sizing: border-box; margin: 0; padding: 24rpx 0; flex-direction: column; align-items: flex-start; border: 0; border-bottom: 2rpx solid #e3e9ee; border-radius: 0; color: #536a82; background: transparent; line-height: 1.4; text-align: left; }
.history-item.active { color: #1e5aa3; }
.history-item-title { color: #173d70; font-size: 25rpx; font-weight: 700; }
.history-item.active .history-item-title { color: #1e5aa3; }
.history-item-meta { margin-top: 6rpx; color: #82918c; font-size: 20rpx; }
.drawer-state { padding: 38rpx 0; color: #718396; font-size: 22rpx; text-align: center; }
.drawer-error { display: flex; padding: 24rpx 0; flex-direction: column; gap: 16rpx; color: #a33a32; font-size: 21rpx; }
.empty-state { margin: 10rpx 0; padding: 18rpx; border-radius: 18rpx; color: #657890; background: #eef5fc; font-size: 20rpx; line-height: 1.6; text-align: center; }
.error-box { display: flex; margin: 10rpx 0 18rpx; padding: 18rpx 20rpx; align-items: center; justify-content: space-between; gap: 12rpx; border-radius: 18rpx; color: #a33a32; background: #fff2f0; font-size: 19rpx; line-height: 1.55; }
.error-box > text { flex: 1; }
.compact-button { width: auto; flex: 0 0 auto; margin: 0; padding: 8rpx 14rpx; font-size: 18rpx; line-height: 1.4; }
.chat-list { min-height: 0; flex: 1; padding: 20rpx 26rpx 184rpx; overflow-y: auto; }
.time-label { margin: 18rpx 0 30rpx; color: #a6b1ad; font-size: 20rpx; text-align: center; }
.message-row { display: flex; margin: 0 0 26rpx; align-items: flex-start; gap: 14rpx; }
.message-row.user { justify-content: flex-end; }
.message-row.notice { margin-left: 68rpx; }
.mini-avatar { display: block; width: 54rpx; height: 54rpx; flex: 0 0 auto; overflow: hidden; border-radius: 18rpx 18rpx 18rpx 6rpx; background: #fff; }
.message-bubble { max-width: 81%; box-sizing: border-box; padding: 20rpx 24rpx; border: 2rpx solid #dde7f3; border-radius: 8rpx 28rpx 28rpx 28rpx; color: #172b45; background: #fff; font-size: 26rpx; line-height: 1.65; white-space: pre-wrap; box-shadow: 0 4rpx 12rpx rgba(17,54,44,.04); }
.message-row.user .message-bubble { border-color: #1e5aa3; border-radius: 28rpx 8rpx 28rpx 28rpx; color: #fff; background: #1e5aa3; }
.message-row.notice .message-bubble { max-width: 100%; padding: 14rpx 20rpx; border-color: #ecdfba; border-radius: 20rpx; color: #8a6d2f; background: #fff9e8; font-size: 20rpx; }
.typing { display: flex; padding: 6rpx; gap: 8rpx; }
.typing text { width: 10rpx; height: 10rpx; border-radius: 50%; background: #91a59d; }
.result-card { display: flex; margin: 0 0 24rpx 68rpx; padding: 24rpx; flex-direction: column; border: 2rpx solid #d4e3f3; border-radius: 28rpx; color: #38584e; background: #fff; box-shadow: 0 12rpx 32rpx rgba(18,59,115,.06); }
.result-head { display: flex; padding-bottom: 20rpx; align-items: flex-start; justify-content: space-between; border-bottom: 2rpx solid #e1ebf5; }
.result-head > view { display: flex; flex-direction: column; }
.result-head > view text:first-child { color: #8296a9; font-size: 19rpx; }
.result-head > view text:last-child { margin-top: 4rpx; color: #172b45; font-family: STSong, serif; font-size: 34rpx; font-weight: 700; }
.result-head > text { margin-top: 6rpx; padding: 6rpx 12rpx; border-radius: 14rpx; color: #1e5aa3; background: #eaf2fb; font-size: 18rpx; font-weight: 700; }
.result-body { padding: 20rpx 0 6rpx; }
.result-block { min-height: 8rpx; color: #38584e; font-size: 23rpx; font-weight: 600; line-height: 1.75; white-space: pre-wrap; }
.result-block.space { min-height: 18rpx; }
.result-block.video { display: block; margin: 18rpx 0; }
.plan-video-button { display: flex; min-height: 88rpx; padding: 0 24rpx; align-items: center; justify-content: center; gap: 16rpx; border: 2rpx solid #bcd6f0; border-radius: 22rpx; color: #1e5aa3; background: #eef5fd; font-size: 24rpx; font-weight: 700; }
.plan-video-button text:first-child { display: flex; width: 46rpx; height: 46rpx; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: #1e5aa3; font-size: 19rpx; }
.plan-video-button-pressed { opacity: .78; background: #deecfa; }
.result-foot { display: flex; margin-top: 14rpx; padding-top: 18rpx; align-items: center; gap: 12rpx; border-top: 2rpx solid #e1ebf5; color: #71869b; font-size: 19rpx; }
.result-foot text:first-child { padding: 4rpx 10rpx; border-radius: 10rpx; color: #1e5aa3; background: #eaf2fb; font-size: 17rpx; font-weight: 700; }
.result-disclaimer { margin-top: 14rpx; color: #82918c; font-size: 18rpx; line-height: 1.5; }
.unavailable-card { display: flex; width: 81%; box-sizing: border-box; margin: 20rpx 0 32rpx 68rpx; padding: 24rpx; flex-direction: column; gap: 8rpx; border: 2rpx solid #c8ddf2; border-radius: 30rpx; color: #536a82; background: #eef5fd; font-size: 20rpx; line-height: 1.5; }
.unavailable-card text:first-child { color: #1e5aa3; font-size: 24rpx; font-weight: 700; }
.start-card { display: flex; width: 81%; box-sizing: border-box; margin: 20rpx 0 32rpx 68rpx; padding: 24rpx; align-items: center; gap: 20rpx; border: 2rpx solid #c8ddf2; border-radius: 30rpx; background: linear-gradient(135deg,#fff,#f0f6fd); text-align: left; box-shadow: 0 16rpx 44rpx rgba(30,90,163,.10); transition: transform .12s ease, opacity .12s ease; }
.start-icon { display: flex; width: 74rpx; height: 74rpx; flex: 0 0 auto; align-items: center; justify-content: center; border-radius: 24rpx; color: #fff; background: #1e5aa3; font-size: 26rpx; }
.start-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.start-copy text:first-child { color: #172b45; font-size: 26rpx; font-weight: 700; }
.start-copy text:last-child { margin-top: 6rpx; color: #7f938c; font-size: 20rpx; }
.start-action { display: flex; min-width: 122rpx; height: 58rpx; box-sizing: border-box; flex: 0 0 auto; padding: 0 18rpx; align-items: center; justify-content: center; gap: 8rpx; border-radius: 29rpx; color: #fff; background: #1e5aa3; font-size: 20rpx; font-weight: 700; white-space: nowrap; }
.start-action text:last-child { font-size: 30rpx; line-height: 1; }
.start-card-pressed { opacity: .84; transform: scale(.99); }
.start-card.disabled { opacity: .6; }
.pending-card { width: calc(100% - 68rpx); box-sizing: border-box; margin: 4rpx 0 28rpx 68rpx; padding: 24rpx; border: 2rpx solid #d7e6de; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 32rpx rgba(31,104,83,.05); }
.pending-title { display: flex; align-items: center; gap: 14rpx; color: #2c4f43; font-size: 24rpx; font-weight: 700; }
.pending-title text:first-child { display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; border-radius: 14rpx; color: #1e5aa3; background: #eaf2fb; font-size: 20rpx; }
.pending-question { width: 100%; box-sizing: border-box; margin-top: 16rpx; color: #38584e; font-size: 23rpx; line-height: 1.6; }
.pending-question:first-child { margin-top: 0; }
.pending-option { display: flex; width: 100%; min-height: 80rpx; box-sizing: border-box; margin: 12rpx 0 0; padding: 18rpx 20rpx; align-items: center; justify-content: flex-start; gap: 16rpx; border: 2rpx solid #dbe9e2; border-radius: 20rpx; color: #38584e; background: #fafcfa; font-size: 22rpx; font-weight: 600; line-height: 1.5; text-align: left; }
.pending-option-pressed { border-color: #aacdbd; background: #f1f8f4; }
.pending-option.disabled { opacity: .6; }
.pending-option > text { display: flex; width: 38rpx; height: 38rpx; flex: 0 0 auto; align-items: center; justify-content: center; border: 2rpx solid #bcd8ca; border-radius: 50%; color: #1e5aa3; font-size: 18rpx; font-weight: 700; }
.pending-option > text:last-child { display: block; width: auto; height: auto; flex: 1; border: 0; border-radius: 0; color: inherit; font-size: inherit; font-weight: inherit; }
.end-card { display: flex; margin: 0 0 18rpx; padding: 18rpx 20rpx; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 12rpx; border: 2rpx solid #c9def3; border-radius: 20rpx; color: #536a82; background: #eef5fd; font-size: 20rpx; }
.end-card > text { flex: 1; min-width: 200rpx; }
.end-card button { width: auto; margin: 0; padding: 10rpx 16rpx; border: 0; border-radius: 16rpx; color: #fff; background: #1e5aa3; font-size: 19rpx; line-height: 1.4; }
.composer { position: fixed; z-index: 10; right: 0; bottom: calc(108rpx + env(safe-area-inset-bottom)); left: 0; display: flex; min-height: 168rpx; box-sizing: border-box; padding: 18rpx 24rpx 26rpx; align-items: center; gap: 14rpx; border-top: 2rpx solid #e4e9e6; background: #fff; }
.composer-mascot { position: absolute; left: 30rpx; bottom: 100%; width: 130rpx; height: 165rpx; }
.composer-input { min-width: 0; height: 84rpx; flex: 1; box-sizing: border-box; padding: 0 34rpx; border-radius: 24rpx; color: #172b45; background: #f1f4f2; font-size: 26rpx; }
.composer-placeholder { color: #8b918f; font-size: 26rpx; }
.send-button { display: flex; width: 84rpx; height: 84rpx; flex: 0 0 auto; align-items: center; justify-content: center; border-radius: 24rpx; color: #fff; background: #1e5aa3; font-size: 42rpx; line-height: 1; }
.send-button text { margin-top: -4rpx; }
.send-button-pressed { opacity: .78; transform: scale(.97); }
.send-button.disabled { opacity: .45; }
