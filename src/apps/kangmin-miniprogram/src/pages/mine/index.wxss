.profile-view { min-height: 100vh; background: linear-gradient(180deg,#edf4fc 0,#f3f6fb 360rpx); }
.profile-hero { display: flex; min-height: 204rpx; box-sizing: border-box; align-items: center; gap: 20rpx; padding: 30rpx; border-radius: 34rpx; color: #fff; background: linear-gradient(135deg,#245fa7,#123b73); box-shadow: 0 22rpx 45rpx rgba(18,59,115,.18); }
.profile-avatar { display: flex; flex: 0 0 94rpx; width: 94rpx; height: 94rpx; align-items: center; justify-content: center; box-sizing: border-box; border: 3rpx solid rgba(255,255,255,.72); border-radius: 30rpx; background: rgba(255,255,255,.16); font-family: STSong, serif; font-size: 38rpx; font-weight: 700; }
.profile-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; color: #c7dcf5; font-size: 16rpx; }
.profile-name { margin: 5rpx 0 7rpx; color: #fff; font-size: 31rpx; font-weight: 700; }
.edit-pill { padding: 10rpx 16rpx; border: 2rpx solid rgba(255,255,255,.45); border-radius: 28rpx; background: rgba(255,255,255,.12); font-size: 16rpx; }
.profile-summary { display: grid; grid-template-columns: repeat(3,1fr); margin: -2rpx 14rpx 24rpx; padding: 24rpx 14rpx; border-radius: 0 0 28rpx 28rpx; background: #fff; box-shadow: 0 14rpx 38rpx rgba(18,59,115,.08); }
.profile-summary > view { display: flex; flex-direction: column; align-items: center; gap: 5rpx; border-right: 2rpx solid #e8edf4; color: #8493a7; font-size: 14rpx; }
.profile-summary > view:last-child { border-right: 0; }
.profile-summary > view text:first-child { color: #173d70; font-size: 28rpx; font-weight: 700; }
.profile-section { margin-top: 20rpx; overflow: hidden; border: 2rpx solid #e1e8f1; border-radius: 29rpx; background: #fff; }
.section-label { display: block; padding: 22rpx 24rpx 14rpx; color: #6d7e94; font-size: 18rpx; font-weight: 700; }
.profile-item { display: flex; align-items: center; gap: 17rpx; padding: 19rpx 22rpx; border-top: 2rpx solid #edf1f6; background: #fff; }
.profile-item > view:nth-child(2) { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.profile-item > view:nth-child(2) text:first-child { font-size: 22rpx; font-weight: 700; }
.profile-item > view:nth-child(2) text:last-child { margin-top: 5rpx; overflow: hidden; color: #8a98a9; font-size: 16rpx; text-overflow: ellipsis; white-space: nowrap; }
.profile-item > text { color: #a6b1bf; font-size: 31rpx; }
.message-action { display: flex; align-items: center; gap: 10rpx; color: #a6b1bf; }
.message-action > text:last-child { font-size: 31rpx; }
.message-badge { min-width: 30rpx; padding: 3rpx 8rpx; border-radius: 18rpx; color: #fff; background: #d66b58; text-align: center; font-size: 15rpx; line-height: 1.3; }
.item-icon { display: flex; width: 56rpx; height: 56rpx; align-items: center; justify-content: center; border-radius: 17rpx; font-size: 20rpx; font-weight: 700; }
.blue { color: #2d6aad; background: #e7f0fb; }.amber { color: #9a6d12; background: #fff4d8; }.mint { color: #277a68; background: #e5f4ef; }.violet { color: #6e5ba4; background: #eeeafb; }.gray { color: #68788b; background: #edf1f5; }
.profile-disclaimer { padding: 24rpx 18rpx 0; color: #8492a6; text-align: center; font-size: 16rpx; line-height: 1.65; }
