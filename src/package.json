{
  "name": "@kangmin/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "kangmin": "./dist/cli/kangmin.js",
    "kangmin-admin": "./dist/cli/kangmin-admin.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && npm run build --workspace @kangmin/core && tsc -p tsconfig.json && node scripts/write-miniprogram-questionnaire.mjs && npm run build --workspace @kangmin/admin",
    "typecheck": "npm run typecheck --workspace @kangmin/core && tsc -p tsconfig.json --noEmit && npm run typecheck --workspace @kangmin/admin",
    "lint": "node scripts/architecture-check.mjs --self-test && node scripts/architecture-check.mjs && node scripts/check-miniprogram.mjs && node scripts/check-admin-app.mjs && node scripts/check-core-package.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js && npm test --workspace @kangmin/admin && node scripts/web-browser-e2e.mjs",
    "test:smoke:core": "npm run build --silent && node scripts/run-core-smoke.mjs",
    "test:smoke:content": "npm run build --silent && node scripts/run-content-smoke.mjs",
    "test:smoke:record": "npm run build --silent && node scripts/run-record-smoke.mjs",
    "test:smoke:shell": "npm run build --silent && node scripts/run-shell-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev:session": "npm run build --silent && node dist/dev/create-session.js",
    "dev:admin-session": "npm run build --silent && node dist/dev/create-admin-session.js",
    "start:http": "npm run build --silent && node dist/http/server.js",
    "prepare:manual-knowledge": "npm run build --silent && node dist/scripts/prepare-manual-knowledge.js",
    "eval:validate": "npm run build --silent && node dist/scripts/validate-agent-evals.js",
    "eval:grade": "npm run build --silent && node dist/scripts/grade-agent-eval-results.js",
    "eval:baseline": "npm run build --silent && node dist/scripts/run-agent-eval-baseline.js",
    "sbom": "node scripts/write-sbom.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jszip": "^3.10.1",
    "playwright": "^1.60.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "pg": "^8.22.0"
  }
}
