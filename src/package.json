{
  "name": "@kangmin/patient-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "kangmin": "./dist/cli/kangmin.js",
    "kangmin-admin": "./dist/cli/kangmin-admin.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/copy-web-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/architecture-check.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js && node scripts/web-browser-e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev:session": "npm run build --silent && node dist/dev/create-session.js",
    "dev:admin-session": "npm run build --silent && node dist/dev/create-admin-session.js",
    "start:http": "npm run build --silent && node dist/http/server.js"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.20.3",
    "playwright": "^1.60.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
