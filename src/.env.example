# 抗敏先锋正式环境示例。复制为服务器受限权限的 .env.production，禁止提交真实密钥。
KANGMIN_APP_ENV=production
KANGMIN_HTTP_HOST=0.0.0.0
PORT=8787

# 腾讯云 PostgreSQL：优先同地域私网地址，并要求 sslmode=require。
KANGMIN_DATABASE_URL=postgresql://kangmin:REPLACE_ME@10.0.0.10:5432/kangmin?sslmode=require

# 腾讯云 COS 的 S3 兼容配置（北京地域内网端点）。Bucket 名包含腾讯云账号 AppID 后缀。
KANGMIN_S3_BUCKET=REPLACE_BUCKET-REPLACE_TENCENT_APPID
KANGMIN_S3_ENDPOINT=https://cos-internal.ap-beijing.myqcloud.com
KANGMIN_S3_REGION=ap-beijing
KANGMIN_S3_FORCE_PATH_STYLE=0
# COS 兼容端点关闭 AWS checksum 签名头，上传确认阶段仍会下载重算 SHA-256。
KANGMIN_S3_SIGN_CHECKSUM=0
KANGMIN_S3_ACCESS_KEY_ID=REPLACE_SECRET_ID
KANGMIN_S3_SECRET_ACCESS_KEY=REPLACE_SECRET_KEY

# 使用 `openssl rand -base64 32` 生成；轮换时把新版本放在最前。
KANGMIN_ENCRYPTION_KEYS=v1:REPLACE_BASE64_32_BYTE_KEY

# Web 确认阶段关闭微信登录；接入小程序时改为 1，并通过服务器密钥注入 AppSecret。
KANGMIN_WECHAT_ENABLED=0
KANGMIN_WECHAT_APP_ID=wxec3aeaadcddaf45e
KANGMIN_WECHAT_APP_SECRET=

# 报价范围未包含环境数据，正式环境显式关闭，不阻断核心服务就绪。
KANGMIN_ENVIRONMENT_ENABLED=0

# 可选：配置后启用模型提取、规则结果解释与知识问答生成；未配置时确定性降级。
KANGMIN_DEEPSEEK_API_KEY=

# 通义千问（DashScope）：诊一诊规则结果动态转译与方案后追问；未配置时固定模板降级。
KANGMIN_QWEN_API_KEY=
KANGMIN_QWEN_MODEL=qwen3.7-flash
KANGMIN_QWEN_VL_MODEL=
# 知识语义索引与查询必须使用同一模型；切换后需重新建立全部知识索引。
KANGMIN_EMBEDDING_MODEL=text-embedding-v4
# 仅在私有兼容端点或集成测试中覆盖；生产缺省连接 DashScope 官方端点。
KANGMIN_EMBEDDING_BASE_URL=
