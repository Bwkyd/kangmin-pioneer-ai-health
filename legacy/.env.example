ADMIN_USERNAME=admin
# PBKDF2 hash: iterations.salt-base64.hash-base64. Never commit a real password.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# 健康记录本地/集成测试身份：仅允许显式配置的合成身份，不能用于 staging/production。
# Cloudflare 本地开发请将以下变量复制到未入库的 .dev.vars；生产环境必须接入服务端验证手机号身份。
APP_ENV=local
HEALTH_IDENTITY_MODE=synthetic
HEALTH_SYNTHETIC_USER_ID=usr_test_demo
